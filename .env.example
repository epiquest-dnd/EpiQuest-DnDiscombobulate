# Modèle de configuration locale.
#
# Copier ce fichier vers `.env` et renseigner les valeurs.
# Ne jamais versionner `.env` ni mettre de vrai secret ici.
#
# Chaque variable doit être décrite par un commentaire : à quoi elle sert,
# si elle est obligatoire et un exemple de valeur sans danger.

# --- Docker Compose (compose.yaml) ---

# Mot de passe de PostgreSQL. Obligatoire. En local, n'importe quelle valeur ;
# en production, une valeur longue et aléatoire (`openssl rand -base64 32`).
POSTGRES_PASSWORD=change-moi

# Utilisateur et nom de la base. Facultatifs, `epiquest` par défaut.
# POSTGRES_USER=epiquest
# POSTGRES_DB=epiquest

# Adresse servie par Caddy. Facultative, `http://localhost` par défaut (pas de HTTPS en local).
# En production : l'IP du VPS, sans schéma, pour obtenir un certificat HTTPS (ex. 159.173.138.75).
# SITE_ADDRESS=http://localhost

# Image du serveur. Facultative : en local, l'image est construite depuis le Dockerfile.
# En production, le déploiement continu l'écrit lui-même (ex. ghcr.io/angikonys/epiquest-dndiscombobulate:<sha>).
# EPIQUEST_IMAGE=epiquest-server:local

# --- Serveur (apps/server), hors Docker ---

# Port d'écoute. Facultatif, 3000 par défaut.
# PORT=3000

# Dossier du site Vue construit, servi par le serveur. Facultatif : sans lui, le serveur ne sert que l'API.
# Déjà défini dans l'image Docker.
# WEB_DIST_DIR=apps/web/dist
