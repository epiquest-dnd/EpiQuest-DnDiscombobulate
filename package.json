{
  "name": "epiquest",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/rules-engine",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @epiquest/server",
    "dev:web": "npm run dev --workspace @epiquest/web",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait db",
    "db:generate": "npm run db:generate --workspace @epiquest/server",
    "db:migrate": "npm run db:migrate --workspace @epiquest/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run typecheck && vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,html}": "prettier --write"
  }
}
